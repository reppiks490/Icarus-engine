//@version=5
// ============================================================================
// ICARUS ENGINE -- unified intraday liquidity-sweep system
// ----------------------------------------------------------------------------
// This is the chart-side twin of the Python core in /icarus. Same premise, same
// gates, same risk envelope:
//
//   A known pool of resting liquidity is raided, the raid fails and the level is
//   reclaimed, order flow and structure confirm the failure, and the volatility
//   regime is worth paying the spread for.
//
// Parity notes against the Python engine:
//   * Signals are evaluated on bar close (`process_orders_on_close=true`) and
//     fill on the next bar, matching the engine's causal fill rule.
//   * Delta is the close-location proxy. TradingView does not serve aggressor
//     volume on standard bars, so the ORDER FLOW weight is the proxy weight.
//   * Percentile ranks use ta.percentrank, which matches RollingWindow.percentile_of.
// ============================================================================

strategy("Icarus Engine", overlay = true, pyramiding = 0,
     initial_capital        = 100000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 100,
     calc_on_every_tick     = false,
     process_orders_on_close = true,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.01,
     slippage               = 1)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
gRegime  = "Volatility regime"
atrLen       = input.int(14,   "ATR length",              group = gRegime, minval = 2)
regimeLook   = input.int(240,  "Regime lookback (bars)",  group = gRegime, minval = 30)
minAtrPct    = input.float(20, "Min ATR percentile",      group = gRegime, minval = 0, maxval = 100)
maxAtrPct    = input.float(97, "Max ATR percentile",      group = gRegime, minval = 0, maxval = 100)
maxShockAtr  = input.float(4.0,"Reject bar range above (ATR)", group = gRegime, minval = 1.0)

gStruct  = "Structure"
pivotLen     = input.int(2,    "Swing strength",          group = gStruct, minval = 1)

gSweep   = "Liquidity sweep"
minPenAtr    = input.float(0.05, "Min penetration (ATR)", group = gSweep, minval = 0.0)
maxPenAtr    = input.float(1.30, "Max penetration (ATR)", group = gSweep, minval = 0.1)
reclaimBars  = input.int(3,      "Reclaim window (bars)", group = gSweep, minval = 1)

gFlow    = "Order flow"
cvdFast      = input.int(12,   "CVD fast EMA",            group = gFlow, minval = 2)
cvdSlow      = input.int(48,   "CVD slow EMA",            group = gFlow, minval = 3)

gScore   = "Confluence"
wSweep       = input.float(1.00, "Weight: sweep quality", group = gScore, minval = 0)
wFlow        = input.float(0.95, "Weight: order flow",    group = gScore, minval = 0)
wStructure   = input.float(0.85, "Weight: structure",     group = gScore, minval = 0)
wVol         = input.float(0.55, "Weight: volatility",    group = gScore, minval = 0)
wLocation    = input.float(0.70, "Weight: location",      group = gScore, minval = 0)
wMomentum    = input.float(0.45, "Weight: momentum",      group = gScore, minval = 0)
minScore     = input.float(0.58, "Minimum score",         group = gScore, minval = 0, maxval = 1)

gRisk    = "Risk"
riskPct      = input.float(0.50, "Risk per trade (% equity)", group = gRisk, minval = 0.01)
stopBufAtr   = input.float(0.35, "Stop buffer beyond raid (ATR)", group = gRisk, minval = 0.0)
firstTargetR = input.float(1.0,  "First target (R)",      group = gRisk, minval = 0.1)
runnerR      = input.float(2.6,  "Runner target (R)",     group = gRisk, minval = 0.2)
scaleOutPct  = input.int(55,     "Scale out at first target (%)", group = gRisk, minval = 0, maxval = 100)
trailAtr     = input.float(1.6,  "ATR trail after scale-out", group = gRisk, minval = 0.0)
timeStopBars = input.int(36,     "Time stop (bars)",      group = gRisk, minval = 1)

gSession = "Session"
useSession   = input.bool(true, "Restrict to session",    group = gSession)
sessionStr   = input.session("0930-1130,1330-1555", "Session", group = gSession)
sessionTz    = input.string("America/New_York", "Timezone", group = gSession)
flatAtEnd    = input.bool(true, "Flatten at session end", group = gSession)

// ---------------------------------------------------------------------------
// Volatility regime -- the permission slip
// ---------------------------------------------------------------------------
atr       = ta.atr(atrLen)
atrPct    = ta.percentrank(atr, regimeLook)
atrFast   = ta.ema(atr, math.max(2, int(atrLen / 2)))
atrSlow   = ta.ema(atr, atrLen * 3)
expansion = atrSlow > 0 ? atrFast / atrSlow : 1.0
rangeBase = ta.sma(high - low, math.max(20, atrLen * 4))
squeeze   = rangeBase > 0 ? (high - low) / rangeBase : 1.0
shock     = atr > 0 ? (high - low) / atr : 0.0

regimeOk = atr > 0 and atrPct >= minAtrPct and atrPct <= maxAtrPct and shock <= maxShockAtr

// Regime fitness, mirroring VolatilityState.fitness: mid-band volatility,
// rewarded further for expanding out of compression.
band      = math.max(0.0, 1.0 - math.abs(atrPct / 100.0 - 0.55) / 0.55)
breakout  = math.min(1.0, math.max(0.0, (expansion - 0.95) / 0.35))
coiled    = math.min(1.0, math.max(0.0, (1.05 - squeeze) / 0.35))
volScore  = regimeOk ? math.min(1.0, 0.45 * band + 0.35 * breakout + 0.20 * coiled) : 0.0

// ---------------------------------------------------------------------------
// Session bookkeeping
// ---------------------------------------------------------------------------
inSession   = not useSession or not na(time(timeframe.period, sessionStr, sessionTz))
sessionEnd  = useSession and inSession[1] and not inSession
newDay      = ta.change(time("D")) != 0

var float sessHigh = na
var float sessLow  = na
var float pdh      = na
var float pdl      = na
if newDay
    pdh := sessHigh
    pdl := sessLow
    sessHigh := high
    sessLow  := low
else
    sessHigh := na(sessHigh) ? high : math.max(sessHigh, high)
    sessLow  := na(sessLow)  ? low  : math.min(sessLow,  low)

// ---------------------------------------------------------------------------
// Structure -- pivots, trend state, BOS / CHoCH
// ---------------------------------------------------------------------------
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float lastPH  = na
var float lastPL  = na
var int   trend   = 0
var int   lastEvt = 0            // +2 CHoCH up, +1 BOS up, -1 BOS down, -2 CHoCH down
var int   lastEvtBar = -10000

if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// A break is only real on a CLOSE through the level; a wick through it is a raid.
if not na(lastPH) and close > lastPH
    lastEvt := trend >= 0 ? 1 : 2
    lastEvtBar := bar_index
    trend := 1
else if not na(lastPL) and close < lastPL
    lastEvt := trend <= 0 ? -1 : -2
    lastEvtBar := bar_index
    trend := -1

structureScore(int dir) =>
    float s = 0.5 + 0.25 * trend * dir
    int   age = bar_index - lastEvtBar
    if age <= 8
        float fresh = 1.0 - age / 8.0
        bool wantChoch = (dir > 0 and lastEvt == 2)  or (dir < 0 and lastEvt == -2)
        bool wantBos   = (dir > 0 and lastEvt == 1)  or (dir < 0 and lastEvt == -1)
        s := wantChoch ? s + 0.45 * fresh : wantBos ? s + 0.30 * fresh : s - 0.30 * fresh
    math.max(0.0, math.min(1.0, s))

// ---------------------------------------------------------------------------
// Order flow -- close-location delta proxy, session-anchored CVD
// ---------------------------------------------------------------------------
clv   = (high - low) > 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
delta = clv * nz(volume)

var float cvd = 0.0
cvd := newDay ? delta : cvd + delta

cvdF     = ta.ema(cvd, cvdFast)
cvdS     = ta.ema(cvd, cvdSlow)
avgVol   = ta.sma(math.max(nz(volume), 1), math.max(40, cvdSlow))
cvdSlope = avgVol > 0 ? (cvdF - cvdS) / avgVol : 0.0
deltaZ   = ta.stdev(delta, math.max(40, cvdSlow)) > 0 ? (delta - ta.sma(delta, math.max(40, cvdSlow))) / ta.stdev(delta, math.max(40, cvdSlow)) : 0.0

// Absorption: heavy volume that fails to travel -- somebody is filling size.
volZ     = ta.stdev(volume, math.max(40, cvdSlow)) > 0 ? (volume - ta.sma(volume, math.max(40, cvdSlow))) / ta.stdev(volume, math.max(40, cvdSlow)) : 0.0
travel   = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0
squash(float v, float scale) => 0.5 * (1.0 + (math.exp(2 * v / scale) - 1) / (math.exp(2 * v / scale) + 1))
absorption = math.min(1.0, math.max(0.0, squash(volZ, 1.2) * (1.0 - travel) * 1.6))

flowScore(int dir) =>
    float slope   = squash(dir * cvdSlope, 0.35)
    float impulse = squash(dir * deltaZ, 1.5)
    math.min(1.0, math.max(0.0, 0.45 * slope + 0.30 * impulse + 0.25 * absorption))

// ---------------------------------------------------------------------------
// Location -- premium / discount against session VWAP
// ---------------------------------------------------------------------------
vwapVal = ta.vwap(hlc3)
vwapDev = ta.stdev(hlc3 - vwapVal, 50)
devSig  = vwapDev > 0 ? (close - vwapVal) / vwapDev : 0.0

locationScore(int dir) =>
    float fav = -dir * devSig                 // positive == buying a discount
    float s = fav <= 0 ? 0.5 + 0.18 * fav
             : 0.5 + 0.5 * math.min(fav, 2.5) / 2.5 - 0.22 * math.max(0.0, fav - 3.0)
    math.max(0.0, math.min(1.0, s))

rsiVal = ta.rsi(close, 14)
momentumScore(int dir) =>
    float base    = 0.5 + 0.30 * trend * dir
    float stretch = (rsiVal - 50.0) / 50.0
    float tired   = math.max(0.0, dir * stretch - 0.55) / 0.45
    math.max(0.0, math.min(1.0, base - 0.35 * math.min(1.0, tired)))

// ---------------------------------------------------------------------------
// Liquidity sweep state machine
// ---------------------------------------------------------------------------
// Levels watched, richest pool first. Prior-session extremes carry the most
// resting size; swing pivots carry the least.
poolHigh = na(pdh) ? lastPH : (na(lastPH) ? pdh : math.max(pdh, lastPH))
poolLow  = na(pdl) ? lastPL : (na(lastPL) ? pdl : math.min(pdl, lastPL))
weightHigh = not na(pdh) and poolHigh == pdh ? 1.00 : 0.65
weightLow  = not na(pdl) and poolLow  == pdl ? 1.00 : 0.65

var int   pendDir  = 0           // -1 raid above a high, +1 raid below a low
var float pendLvl  = na
var float pendExt  = na
var int   pendBar  = na
var float pendRej  = 0.0
var float pendWgt  = 0.0

penetrationAtr(float extreme, float level, int dir) =>
    atr > 0 ? (dir < 0 ? (extreme - level) / atr : (level - extreme) / atr) : 0.0

// Open a pending raid.
if pendDir == 0 and atr > 0
    if not na(poolHigh) and high > poolHigh
        float pen = (high - poolHigh) / atr
        if pen >= minPenAtr and pen <= maxPenAtr
            pendDir := -1
            pendLvl := poolHigh
            pendExt := high
            pendBar := bar_index
            pendRej := (high - low) > 0 ? (high - math.max(open, close)) / (high - low) : 0.0
            pendWgt := weightHigh
    else if not na(poolLow) and low < poolLow
        float pen = (poolLow - low) / atr
        if pen >= minPenAtr and pen <= maxPenAtr
            pendDir := 1
            pendLvl := poolLow
            pendExt := low
            pendBar := bar_index
            pendRej := (high - low) > 0 ? (math.min(open, close) - low) / (high - low) : 0.0
            pendWgt := weightLow

// Extend / resolve the pending raid.
bool    sweepFired   = false
int     sweepDir     = 0
float   sweepExtreme = na
float   sweepQuality = 0.0

if pendDir != 0
    if pendDir < 0
        pendExt := math.max(pendExt, high)
        pendRej := math.max(pendRej, (high - low) > 0 ? (high - math.max(open, close)) / (high - low) : 0.0)
    else
        pendExt := math.min(pendExt, low)
        pendRej := math.max(pendRej, (high - low) > 0 ? (math.min(open, close) - low) / (high - low) : 0.0)

    float pen      = penetrationAtr(pendExt, pendLvl, pendDir)
    int   age      = bar_index - pendBar
    bool  reclaimed = pendDir < 0 ? close < pendLvl : close > pendLvl

    if pen > maxPenAtr
        pendDir := 0                                    // genuine break, not a raid
    else if reclaimed
        float span   = math.max(1e-9, maxPenAtr - minPenAtr)
        float norm   = (pen - minPenAtr) / span
        float depth  = math.max(0.0, 1.0 - math.abs(norm - 0.33) / 0.67)
        float speed  = 1.0 - math.min(1.0, age / math.max(1, reclaimBars))
        float reject = math.min(1.0, pendRej / 0.6)
        sweepQuality := math.max(0.0, math.min(1.0, 0.32 * depth + 0.26 * speed + 0.24 * reject + 0.18 * pendWgt))
        sweepDir     := pendDir
        sweepExtreme := pendExt
        sweepFired   := true
        pendDir      := 0
    else if age >= reclaimBars
        pendDir := 0                                    // accepted beyond the level

// ---------------------------------------------------------------------------
// Confluence
// ---------------------------------------------------------------------------
weightSum = wSweep + wFlow + wStructure + wVol + wLocation + wMomentum
score = 0.0
if sweepFired and weightSum > 0
    score := (wSweep     * sweepQuality
           +  wFlow      * flowScore(sweepDir)
           +  wStructure * structureScore(sweepDir)
           +  wVol       * volScore
           +  wLocation  * locationScore(sweepDir)
           +  wMomentum  * momentumScore(sweepDir)) / weightSum
    score := score * 0.96                               // proxy order flow discount

goLong  = sweepFired and sweepDir > 0 and regimeOk and inSession and score >= minScore and strategy.position_size == 0
goShort = sweepFired and sweepDir < 0 and regimeOk and inSession and score >= minScore and strategy.position_size == 0

// ---------------------------------------------------------------------------
// Risk envelope
// ---------------------------------------------------------------------------
var float entryPx   = na
var float stopPx    = na
var float riskUnit  = na
var float target1   = na
var float target2   = na
var int   entryBar  = na
var bool  scaled    = false

if goLong or goShort
    int   dir    = goLong ? 1 : -1
    float anchor = sweepExtreme
    float stop   = anchor - dir * stopBufAtr * atr
    float unit   = math.abs(close - stop)
    if unit <= 0
        unit := math.max(atr * stopBufAtr, syminfo.mintick)
        stop := close - dir * unit
    float qty = (strategy.equity * riskPct / 100.0) / unit

    entryPx  := close
    stopPx   := stop
    riskUnit := unit
    target1  := close + dir * firstTargetR * unit
    target2  := close + dir * runnerR * unit
    entryBar := bar_index
    scaled   := false

    if goLong
        strategy.entry("L", strategy.long, qty = qty)
    else
        strategy.entry("S", strategy.short, qty = qty)

// Manage the live position: scale out, breakeven, ATR trail, time stop, flatten.
if strategy.position_size != 0 and not na(stopPx)
    int dir = strategy.position_size > 0 ? 1 : -1
    string id = dir > 0 ? "L" : "S"

    bool hitFirst = dir > 0 ? high >= target1 : low <= target1
    if hitFirst and not scaled
        scaled := true
        stopPx := entryPx                                // risk removed

    if scaled and trailAtr > 0
        float cand = dir > 0 ? high - trailAtr * atr : low + trailAtr * atr
        stopPx := dir > 0 ? math.max(stopPx, cand) : math.min(stopPx, cand)

    if scaleOutPct > 0 and not scaled
        strategy.exit("T1", from_entry = id, qty_percent = scaleOutPct, limit = target1, stop = stopPx)
    strategy.exit("T2", from_entry = id, limit = target2, stop = stopPx)

    bool timedOut = bar_index - entryBar >= timeStopBars and dir * (close - entryPx) < 0.5 * riskUnit
    bool mustFlat = flatAtEnd and sessionEnd
    if timedOut or mustFlat
        strategy.close_all(comment = timedOut ? "time-stop" : "session-flatten")

// ---------------------------------------------------------------------------
// Visuals
// ---------------------------------------------------------------------------
plot(poolHigh, "Pool high", color = color.new(color.red, 55),  style = plot.style_linebr)
plot(poolLow,  "Pool low",  color = color.new(color.green, 55), style = plot.style_linebr)
plot(vwapVal,  "VWAP",      color = color.new(color.orange, 40))
plotshape(goLong,  "Long",  style = shape.triangleup,   location = location.belowbar,
     color = color.new(color.lime, 0), size = size.tiny)
plotshape(goShort, "Short", style = shape.triangledown, location = location.abovebar,
     color = color.new(color.red, 0),  size = size.tiny)
bgcolor(regimeOk and inSession ? na : color.new(color.gray, 92), title = "Stand-down")

plot(strategy.position_size != 0 ? stopPx : na, "Stop", color = color.new(color.fuchsia, 0),
     style = plot.style_linebr)

alertcondition(goLong,  "Icarus long",  "Icarus: long sweep reclaim confirmed")
alertcondition(goShort, "Icarus short", "Icarus: short sweep reclaim confirmed")
